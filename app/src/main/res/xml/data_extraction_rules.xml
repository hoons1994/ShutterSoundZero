<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Never back up the device-bound ADB identity to cloud storage. -->
        <exclude domain="file" path="adb_private_key.der" />
        <exclude domain="file" path="adb_cert.der" />
    </cloud-backup>
    <device-transfer>
        <!-- A restored ADB identity must not be reused on a different device. -->
        <exclude domain="file" path="adb_private_key.der" />
        <exclude domain="file" path="adb_cert.der" />
    </device-transfer>
</data-extraction-rules>
